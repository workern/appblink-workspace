{
  "name": "@workern/functions-ts",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase serve --only functions",
    "shell": "firebase experimental:functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "lint": "tslint --project tsconfig.json",
    "clean": "rimraf lib",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "logs": "firebase functions:log",
    "dev": "tsc --watch & tsc-alias --watch -p tsconfig.json",
    "seed:billing-products": "node scripts/init-billing-products.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/tools/firebase/functions-ts/src/index.js",
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@sendgrid/client": "^8.1.3",
    "@sendgrid/mail": "^8.1.3",
    "@sentry/node": "^8.36.0",
    "axios": "^1.7.0",
    "chargebee": "^3.10.0",
    "cors": "2.8.5",
    "ct-razorpayx": "0.0.1-beta.1",
    "dodopayments": "^1.38.0",
    "express": "^4.21.1",
    "fast-glob": "^3.3.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "google-libphonenumber": "^3.2.35",
    "googleapis": "^65.0.0",
    "handlebars": "^4.7.8",
    "lodash": "^4.17.21",
    "nodemailer": "^6.9.14",
    "papaparse":"latest",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.1.14",
    "request": "2.88.0",
    "request-promise": "^4.2.4",
    "secure-compare": "^3.0.1",
    "zeptomail":"latest",
    "zod": "latest"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^22.10.1",
    "concurrently": "^9.0.1",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.8",
    "tsc-alias": "^1.8.10",
    "tslint": "^5.20.1",
    "typescript": "^5.5.0"
  }
}
