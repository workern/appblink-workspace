{
  "compilerOptions": {
    "module": "NodeNext",
    "noImplicitReturns": false,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "outDir": "lib",
    "rootDir": "../../../",
    "sourceMap": true,
    "baseUrl": "../../../",
    "skipLibCheck": true,
    "paths": {
      "@workern/models": ["libs/shared/models/src/index.ts"],
      "@workern/enums": ["libs/shared/models/src/index.ts"]
    },
    "moduleResolution": "NodeNext",
    "target": "es2017",
    "lib": ["es2021", "es2022.error", "dom"]
  },
  "compileOnSave": true,
  "files": ["./src/index.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts", "test/**/*"]
}
