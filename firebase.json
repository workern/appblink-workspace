{
  "functions": [
    {
      "predeploy": "npm --prefix \"$RESOURCE_DIR\" run build",
      "source": "tools/firebase/functions-ts",
      "codebase": "ts",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "tools/firebase/functions-py",
      "codebase": "py",
      "ignore": [
        "venv",
        ".venv",
        "__pycache__",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [

  ],
  "database": {
    "rules": "tools/firebase/database.rules.json"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "tools/firebase/firestore.rules",
    "indexes": "tools/firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9100
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001,
      "region": "asia-south2"
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8081
    },
    "database": {
      "host": "0.0.0.0",
      "port": 9001
    },
    "ui": {
      "host": "0.0.0.0",
      "port": 4002,
      "enabled": true
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "tasks": {
      "host": "0.0.0.0",
      "port": 9499
    },
    "singleProjectMode": true,
    "apphosting": {
      "port": 6001,
      "rootDirectory": "./",
      "startCommand": "npm run dev"
    },
    "hosting": {
      "port": 7000
    }
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.5",
    "firestore-auth-claims": "firebase/firestore-auth-claims@0.1.1"
  },
  "storage": {
    "rules": "tools/firebase/storage.rules"
  },
  "apphosting": []
}
