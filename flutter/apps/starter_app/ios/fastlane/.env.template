# iOS Fastlane Environment Variables Template
# Copy this file to .env and fill in your actual values

# App Store Connect API Key (Recommended method)
APP_STORE_CONNECT_API_KEY_KEY_ID="YOUR_KEY_ID_HERE"
APP_STORE_CONNECT_API_KEY_ISSUER_ID="YOUR_ISSUER_ID_HERE"
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH="/path/to/AuthKey_XXXXXXXXXX.p8"

# Alternative: Apple ID with App-Specific Password
# FASTLANE_USER="your.email@example.com"
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Team IDs (find these in App Store Connect and Developer Portal)
# ITC_TEAM_ID="YOUR_TEAM_ID"
# TEAM_ID="YOUR_DEVELOPER_TEAM_ID"
